#!/usr/bin/env bash
set -e

case "$1" in
    purge|remove)
        if command -v fc-cache &>/dev/null; then
            fc-cache -s || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
